# SOURCE ONLY: requires verified root-owned source and Python crypto runtime.
[Unit]
Description=ClientFlow native RDP lifecycle
Requires=clientflow-rdp-sealer.socket
After=clientflow-rdp-sealer.socket

[Service]
Type=simple
User=root
Group=root
StandardInput=socket
StandardOutput=journal
StandardError=journal
ExecStart=/usr/bin/python3 -I -B -c "import sys; sys.path.insert(0, '/usr/local/libexec/clientflow/native-rdp-pilot'); from scripts.clientflow_63d53_rdp_ipc import lifecycle_main; lifecycle_main()"
RuntimeMaxSec=600
TimeoutStopSec=15
UMask=0077
Restart=no
# The original independent watchdog and firewall remain mandatory.
