[Unit]
Description=ClientFlow Ubuntu 26.04 host platform preparation
After=local-fs.target network-online.target
Wants=network-online.target
Before=clientflow.target clientflow-livestream-producer.service clientflow-remote-desktop-capture.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/clientflow/active/runtime/bin/clientflow-platform-prepare
UMask=0022
NoNewPrivileges=no
PrivateTmp=yes
PrivateDevices=no
ProtectSystem=no
ProtectHome=read-only
ProtectKernelTunables=yes
# APT/dpkg (including dracut/initramfs triggers) must read and update
# /usr/lib/modules. ProtectKernelModules=yes hides that directory, even
# though the host kernel packages are healthy. Expose package files only in
# this privileged package-mutating service; still deny explicit module loads.
ProtectKernelModules=no
CapabilityBoundingSet=~CAP_SYS_MODULE
SystemCallFilter=~@module
ProtectKernelLogs=yes
ProtectControlGroups=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
