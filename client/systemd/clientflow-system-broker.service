[Unit]
Description=ClientFlow fixed-function privileged system broker

[Service]
Type=simple
User=root
Group=root
ExecStart=/opt/clientflow/active/runtime/bin/clientflow-system-broker
LoadCredential=system-private-key.pem:/etc/clientflow/system-private-key.pem
StateDirectory=clientflow/system-broker
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=no
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=no
ProtectHome=read-only
ProtectKernelTunables=yes
# APT/dpkg (including dracut/initramfs triggers) must read and update
# /usr/lib/modules. ProtectKernelModules=yes hides that directory, even
# though the host kernel packages are healthy. Expose package files only in
# this privileged package-mutating service; still deny explicit module loads.
ProtectKernelModules=no
CapabilityBoundingSet=~CAP_SYS_MODULE
SystemCallFilter=~@module
ProtectKernelLogs=yes
ProtectControlGroups=yes
# update_os invokes dpkg, which must install legitimate setuid/setgid package files.
# Keep this exception confined to the root fixed-function system broker;
# unprivileged system-agent and other services remain restricted.
RestrictSUIDSGID=no
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictRealtime=yes
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET AF_INET6
