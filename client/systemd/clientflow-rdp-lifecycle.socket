# Release-owned native RDP unit.
[Unit]
Description=ClientFlow protected native RDP lifecycle socket

[Socket]
ListenStream=/run/clientflow/rdp-lifecycle-v1.sock
SocketUser=root
SocketGroup=clientflow-remote-desktop-agent
SocketMode=0660
DirectoryMode=0755
Accept=yes
MaxConnections=2
RemoveOnStop=yes

[Install]
WantedBy=clientflow.target
