#!/usr/bin/python3
"""Read-only offline fullscreen maintenance display for a ClientFlow kiosk.

Runs as the unprivileged graphical kiosk user, not root. It never opens a
network socket, invokes a privileged action or starts/stops Chrome. The root
System broker remains the sole OS/firmware maintenance-state writer.
"""
from __future__ import annotations

import json
import os
from pathlib import Path
import stat
import sys

STATE_DIR = Path('/var/lib/clientflow/update-maintenance')
STATE_PATH = STATE_DIR / 'state.json'
ACTIONS = {'update_os': 'Ubuntu', 'update_firmware': 'Firmware'}
MESSAGES = {
    'browser_stopping': ('Forbereder opdatering', 'Lukker kioskbrowseren sikkert'),
    'installing': ('Installerer opdatering', 'Systemets komponenter opdateres'),
    'rebooting': ('Afventer genstart', 'Genstart er nødvendig for at afslutte opdateringen'),
    'post_boot_check': ('Kontrollerer systemet', 'Undersøger tjenester efter genstart'),
    'recovery_required': ('Kontrol nødvendig', 'Opdateringen kræver teknisk kontrol'),
}


def _trusted_snapshot() -> dict[str, str] | None:
    """Read ONLY root-controlled non-secret fields; invalid marker stays visible.

    An absent marker or a completed marker closes the display. Broken, symlinked
    or untrusted markers show a recovery warning rather than a false success.
    """
    try:
        try:
            directory = STATE_DIR.lstat()
        except FileNotFoundError:
            return None
        if not stat.S_ISDIR(directory.st_mode) or directory.st_uid != 0 or directory.st_mode & 0o022:
            raise ValueError('untrusted maintenance directory')
        try:
            fd = os.open(STATE_PATH, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
        except FileNotFoundError:
            return None
        try:
            info = os.fstat(fd)
            if not stat.S_ISREG(info.st_mode) or info.st_uid != 0 or info.st_mode & 0o022 or info.st_size > 8192:
                raise ValueError('untrusted maintenance marker')
            with os.fdopen(fd, 'rb', closefd=False) as stream:
                data = stream.read(8193)
        finally:
            os.close(fd)
        if len(data) > 8192:
            raise ValueError('oversize maintenance marker')
        value = json.loads(data.decode('utf-8'))
        if not isinstance(value, dict) or value.get('schema_version') != 1:
            raise ValueError('invalid maintenance schema')
        action = value.get('action')
        phase = value.get('phase')
        if action not in ACTIONS or phase not in (set(MESSAGES) | {'completed'}):
            raise ValueError('invalid maintenance phase')
        if phase == 'completed':
            return None
        return {'action': ACTIONS[action], 'phase': phase}
    except (OSError, ValueError, TypeError, UnicodeError):
        return {'action': 'System', 'phase': 'recovery_required'}


def main() -> int:
    # GTK is deliberately imported only by the actual display process; status
    # parser tests run without GTK or Wayland on GitHub CI.
    import gi
    gi.require_version('Gtk', '4.0')
    from gi.repository import Gdk, Gio, GLib, Gtk

    os.environ.setdefault('GDK_BACKEND', 'wayland')
    app = Gtk.Application(application_id='dk.planiq.DisplayMaintenance', flags=Gio.ApplicationFlags.NON_UNIQUE)

    def activate(application: Gtk.Application) -> None:
        current = _trusted_snapshot()
        if current is None:
            application.quit()
            return
        display = Gdk.Display.get_default()
        if display is None:
            raise RuntimeError('Ingen lokal Wayland-skærm til vedligeholdelsesvisning')
        css = Gtk.CssProvider()
        css.load_from_data(b'''window { background-color: #101828; }
            label { color: #f4f7fc; }
            .brand { font-size: 36px; font-weight: 900; }
            .heading { font-size: 31px; font-weight: 800; }
            .body { font-size: 20px; }
            .foot { color: #a9b8ce; font-size: 15px; }
            .warning { color: #ffc870; }
            .accent { color: #38bdf8; }''')
        Gtk.StyleContext.add_provider_for_display(display, css, Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)

        window = Gtk.ApplicationWindow(application=application)
        window.set_title('PlanIQ Display – vedligeholdelse')
        window.set_decorated(False)
        wrapper = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=22)
        wrapper.set_valign(Gtk.Align.CENTER)
        wrapper.set_halign(Gtk.Align.CENTER)
        wrapper.set_margin_start(36)
        wrapper.set_margin_end(36)
        brand = Gtk.Label(label='PlanIQ Display')
        brand.add_css_class('brand')
        title = Gtk.Label()
        title.add_css_class('heading')
        body = Gtk.Label()
        body.add_css_class('body')
        body.set_wrap(True)
        body.set_justify(Gtk.Justification.CENTER)
        foot = Gtk.Label(label='Skærmen vender tilbage, når systemet er klar.')
        foot.add_css_class('foot')
        for label in (brand, title, body, foot):
            label.set_xalign(0.5)
            wrapper.append(label)
        window.set_child(wrapper)
        previous = None

        def tick() -> bool:
            nonlocal previous
            current_state = _trusted_snapshot()
            if current_state is None:
                window.close()
                application.quit()
                return GLib.SOURCE_REMOVE
            key = (current_state['action'], current_state['phase'])
            if key != previous:
                heading, detail = MESSAGES[current_state['phase']]
                title.set_text(heading)
                body.set_text(f"{current_state['action']}: {detail}")
                title.remove_css_class('warning')
                title.remove_css_class('accent')
                title.add_css_class('warning' if current_state['phase'] == 'recovery_required' else 'accent')
                previous = key
            return GLib.SOURCE_CONTINUE

        tick()
        window.fullscreen()
        window.present()
        GLib.timeout_add_seconds(2, tick)

    app.connect('activate', activate)
    return int(app.run([]))


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except Exception as exc:
        print(f'ClientFlow vedligeholdelsesskærm: {type(exc).__name__}: {exc}', file=sys.stderr, flush=True)
        raise
